{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/docs/quick-start/index.html",
        "http://localhost/en/docs/commands/index.html",
        "http://localhost/en/guides/multiple-claude-code-accounts/index.html",
        "http://localhost/ar/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true } }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
